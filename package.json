{
  "name": "proctra",
  "productName": "Proctra",
  "description": "Secure online examination proctoring suite for macOS",
  "author": "Proctra Team",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "./electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "vite build",
    "dist": "vite build && electron-builder --mac dmg --arm64",
    "dist:universal": "vite build && electron-builder --mac dmg --universal",
    "dist:all": "vite build && electron-builder --mac dmg -c.mac.target=dmg",
    "pack": "vite build && electron-builder --dir",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
